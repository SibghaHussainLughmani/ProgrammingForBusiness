#include <iostream>
using namespace std;
int main() {
    int days;
    cout << "Enter number of days: ";
    cin >> days;
    double *expenses = new double[days];
    double total = 0;
    for (int i = 0; i < days; i++) {
        cout << "Enter expense for day " << i + 1 << ": ";
        cin >> expenses[i];
        total += expenses[i];
    }

    double average = total / days;
    cout << "\nTotal Expense: " << total << endl;
    cout << "Average Expense: " << average << endl;
    delete[] expenses;

    return 0;
}
